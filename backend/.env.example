# MongoDB Atlas connection string (see root README for setup steps)
MONGO_URI=your_mongodb_atlas_connection_string_here

# Groq API key (free) - console.groq.com
AI_API_KEY=your_groq_api_key_here

# Optional - override the model used for summaries. Defaults to llama-3.3-70b-versatile
AI_MODEL=llama-3.3-70b-versatile

PORT=5000
